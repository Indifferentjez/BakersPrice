# Copy to .env and fill in. The app runs fine without ANTHROPIC_API_KEY —
# recipe photo/PDF/text auto-parsing is simply disabled until it is set,
# and manual ingredient entry is always available.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5
# PORT=3001
# DB_PATH=

# Auth (email/password sessions). Required in production.
SESSION_SECRET=

# Optional Google Identity Services (ID-token button). Leave empty to hide Google sign-in.
# Create an OAuth client type "Web application" in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:5173 and your production origin.
# Only the Client ID is needed — no client secret for this flow.
GOOGLE_CLIENT_ID=

# Browser origin allowed for credentialed CORS. Vite dev default:
CLIENT_ORIGIN=http://localhost:5173

# Admin email (case-insensitive). Only this signed-in user can edit/import the
# shared ingredient catalogue. Leave empty and nobody can — GET stays public.
ADMIN_EMAIL=

# Password reset email (Resend, https://resend.com). Leave empty and /forgot
# still works, but only logs the reset link to the server console, and only
# when NODE_ENV is not "production".
RESEND_API_KEY=
MAIL_FROM=

# Stripe billing for the Pro plan. Leave all three empty to keep billing off —
# /pricing shows a disabled Subscribe button ("Billing not configured").
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
